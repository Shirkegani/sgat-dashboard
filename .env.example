# Copy this to .env and fill in your real values.
# .env is gitignored.

# Apps Script deployment URL — get from Apps Script editor:
# Deploy → Manage deployments → copy the /exec URL
SGAT_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Auth token (matches SECRET_TOKEN in Code.gs)
SGAT_TOKEN=your_secret_here
